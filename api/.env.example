# Copy to api/.env and fill in. api/.env is gitignored.
#
# This file configures the API process itself: Settings loads it, anchored to
# this directory rather than to the working directory, so `uv run ...` behaves
# the same from anywhere. Containers never see it -- the Dockerfile does not
# copy it, and compose supplies the environment there instead.

OPENAI_API_KEY=sk-...

# Points at the host-mapped port that docker-compose publishes on loopback
# (127.0.0.1:5432), not the compose-network hostname "db", which only resolves
# from inside the compose network.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/career_intel

LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

MAX_UPLOAD_BYTES=5242880

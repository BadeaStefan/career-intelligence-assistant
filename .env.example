# Copy to .env and fill in. .env is gitignored.

# Required for anything beyond phase 1.
OPENAI_API_KEY=sk-...

# Defaults match docker-compose; override for a local venv against a
# host-mapped database.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/career_intel

LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

MAX_UPLOAD_BYTES=5242880

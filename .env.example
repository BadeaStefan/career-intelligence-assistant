# Copy to .env and fill in. .env is gitignored.
#
# This file configures **docker compose**, not the API process directly.
# Compose reads it to interpolate ${...} in docker-compose.yml, and passes the
# result to the api container as environment variables. A key that appears
# here but is not referenced by docker-compose.yml therefore does nothing.
#
# For a local venv (`cd api && uv run ...`) the API reads api/.env instead --
# see api/.env.example. Settings anchors that path to the api/ directory, so
# it does not matter which directory you launch from.

# Required for anything beyond phase 1.
OPENAI_API_KEY=sk-...

# Database credentials. Compose assembles DATABASE_URL for the api container
# from these three, so setting DATABASE_URL here has no effect -- it would be
# overwritten. Change the credentials here, not the URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=career_intel

LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

MAX_UPLOAD_BYTES=5242880
